# ── Galactic Bridge — приклад .env (скопіюй у .env і заповни) ──
# Файл .env у git НЕ потрапляє (див. .gitignore). Тут лише зразок без секретів.

# ОБОВ'ЯЗКОВО. Підключення гаманця. Отримай ВЛАСНИЙ безкоштовний Project ID
# на https://dashboard.reown.com — без нього вікно вибору гаманця буде порожнім.
# Не використовуй чужий ID: він привʼязаний до чужого акаунта і має свої ліміти.
VITE_REOWN_PROJECT_ID=your_reown_project_id

# Опційно. Веб-аналітика Cloudflare (безкоштовна, без куків).
# Потрібна лише якщо ти хостиш власний сайт і хочеш бачити відвідуваність.
# Токен: Cloudflare -> Analytics -> Web Analytics -> Add a site.
# Якщо порожньо — скрипт аналітики не підключається взагалі.
VITE_CF_BEACON_TOKEN=

# Вузол з АРХІВНИМИ логами для конкретної мережі (опційно).
# Потрібен лише там, де публічний RPC не віддає eth_getLogs у глибину —
# без цього не знайти bridge-адаптер для токена, який сам не є OFT.
# Формат: LOGS_RPC_<КЛЮЧ_МЕРЕЖІ> (bsc, base, eth, arb, poly, op, avax, mantle,
# hyperevm, ink, xlayer, plasma, robinhood). Приклади:
# LOGS_RPC_BSC=https://bsc-mainnet.nodereal.io/v1/ВАШ_КЛЮЧ
# LOGS_RPC_BSC=https://rpc.ankr.com/bsc/ВАШ_КЛЮЧ
#
# Запасний вузол для звичайних викликів (не логів): використовується ЛИШЕ якщо
# публічні вузли не відповіли. Не витрачає ліміти без потреби.
# RPC_FALLBACK_AVAX=https://ваш-вузол/ключ
#
# Примусовий вузол (буде ПЕРШИМ, замість публічних):
# RPC_AVAX=https://ваш-вузол/ключ
PORT=3001

# ── Прод-налаштування (у DEV можна лишити порожнім) ──
# Дозволені домени для CORS (кома-розділ). Приклад:
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# Rate-limit (необов'язково; за замовч. 60 запитів / 15с на IP)
RL_WINDOW_MS=15000
RL_MAX=60
